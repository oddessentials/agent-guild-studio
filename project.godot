; Agent Guild: Studio: makes characters and companions for Agent Guild.
config_version=5

[application]

config/name="Agent Guild Studio"
config/use_custom_user_dir=true
config/custom_user_dir_name="AgentGuildStudio"
config/description="Make characters and companions for Agent Guild."
config/version="0.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.039, 0.059, 1)
boot_splash/image="res://brand/splash.png"
config/icon="res://brand/icon.png"
run/flush_stdout_on_print=true

[debug]

gdscript/warnings/inference_on_variant=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
environment/ssao/quality=2

[importer_defaults]

texture={
"compress/mode": 2,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}
